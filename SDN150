import javax.swing.*;
import javax.swing.filechooser.FileNameExtensionFilter;
import java.awt.*;
import java.awt.geom.AffineTransform;
import java.awt.image.BufferedImage;
import java.io.File;
import java.io.IOException;
import javax.imageio.ImageIO;
import java.util.ArrayList;

public class ImageViewerApp extends JFrame {

    // Variables
    private JLabel imageLabel;
    private JLabel statusLabel;

    private BufferedImage originalImage;
    private BufferedImage currentImage;

    private ArrayList<File> imageFiles = new ArrayList<>();

    private int currentIndex = 0;
    private double zoom = 1.0;

    private Timer slideshowTimer;

    // Constructor
    public ImageViewerApp() {

        setTitle("GROUP 21 - IMAGE VIEWER");
        setSize(900, 650);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout());

        // Application heading
        JLabel heading = new JLabel(
            "GROUP 21 - IMAGE VIEWER",
            SwingConstants.CENTER
        );

        heading.setFont(new Font("Arial", Font.BOLD, 24));
        add(heading, BorderLayout.NORTH);

        // Image display area
        imageLabel = new JLabel(
            "Please open an image",
            SwingConstants.CENTER
        );

        JScrollPane scrollPane = new JScrollPane(imageLabel);
        add(scrollPane, BorderLayout.CENTER);

        // Create buttons
        JPanel buttonPanel = new JPanel(
            new FlowLayout(FlowLayout.CENTER, 5, 10)
        );

        JButton openButton = new JButton("Open Image");
        JButton rotateButton = new JButton("Rotate");
        JButton flipButton = new JButton("Flip");
        JButton zoomInButton = new JButton("Zoom In");
        JButton zoomOutButton = new JButton("Zoom Out");
        JButton nextButton = new JButton("Next");
        JButton previousButton = new JButton("Previous");
        JButton playButton = new JButton("Slideshow");
        JButton stopButton = new JButton("Stop");
        JButton deleteButton = new JButton("Delete");

        // Add buttons
        buttonPanel.add(openButton);
        buttonPanel.add(rotateButton);
        buttonPanel.add(flipButton);
        buttonPanel.add(zoomInButton);
        buttonPanel.add(zoomOutButton);
        buttonPanel.add(previousButton);
        buttonPanel.add(nextButton);
        buttonPanel.add(playButton);
        buttonPanel.add(stopButton);
        buttonPanel.add(deleteButton);

        // Status bar
        statusLabel = new JLabel("Ready");

        JPanel bottomPanel = new JPanel(new BorderLayout());
        bottomPanel.add(buttonPanel, BorderLayout.CENTER);
        bottomPanel.add(statusLabel, BorderLayout.SOUTH);

        add(bottomPanel, BorderLayout.SOUTH);

        // Button event handling
        openButton.addActionListener(e -> openImage());
        rotateButton.addActionListener(e -> rotateImage());
        flipButton.addActionListener(e -> flipImage());
        zoomInButton.addActionListener(e -> zoomIn());
        zoomOutButton.addActionListener(e -> zoomOut());
        nextButton.addActionListener(e -> nextImage());
        previousButton.addActionListener(e -> previousImage());
        playButton.addActionListener(e -> startSlideshow());
        stopButton.addActionListener(e -> stopSlideshow());
        deleteButton.addActionListener(e -> deleteImage());

        // Slideshow timer (3 seconds)
        slideshowTimer = new Timer(3000, e -> nextImage());

        setVisible(true);
    }

    // Open image from computer
    private void openImage() {

        JFileChooser chooser = new JFileChooser();

        chooser.setFileFilter(
            new FileNameExtensionFilter(
                "Image Files",
                "jpg", "jpeg", "png", "gif", "bmp"
            )
        );

        int result = chooser.showOpenDialog(this);

        if (result == JFileChooser.APPROVE_OPTION) {

            File selectedFile = chooser.getSelectedFile();

            File folder = selectedFile.getParentFile();

            imageFiles.clear();

            File[] files = folder.listFiles();

            if (files != null) {

                for (File file : files) {

                    String name = file.getName().toLowerCase();

                    if (name.endsWith(".jpg") ||
                        name.endsWith(".jpeg") ||
                        name.endsWith(".png") ||
                        name.endsWith(".gif") ||
                        name.endsWith(".bmp")) {

                        imageFiles.add(file);
                    }
                }
            }

            currentIndex = imageFiles.indexOf(selectedFile);

            loadImage(selectedFile);
        }
    }

    // Load image
    private void loadImage(File file) {

        try {

            originalImage = ImageIO.read(file);

            if (originalImage == null) {
                throw new IOException("Unsupported image format.");
            }

            currentImage = originalImage;
            zoom = 1.0;

            displayImage();

        } catch (IOException e) {

            JOptionPane.showMessageDialog(
                this,
                "Error opening image: " + e.getMessage()
            );
        }
    }

    // Display image on screen
    private void displayImage() {

        if (currentImage != null) {

            int width = Math.max(1,
                (int)(currentImage.getWidth() * zoom));

            int height = Math.max(1,
                (int)(currentImage.getHeight() * zoom));

            Image scaledImage = currentImage.getScaledInstance(
                width,
                height,
                Image.SCALE_SMOOTH
            );

            imageLabel.setIcon(new ImageIcon(scaledImage));
            imageLabel.setText("");

            statusLabel.setText(
                "Image " + (currentIndex + 1) +
                " of " + imageFiles.size() +
                " | Zoom: " + (int)(zoom * 100) + "%"
            );
        }
    }

    // Rotate image clockwise
    private void rotateImage() {

        if (currentImage == null) {
            showMessage();
            return;
        }

        int width = currentImage.getWidth();
        int height = currentImage.getHeight();

        BufferedImage rotated = new BufferedImage(
            height,
            width,
            BufferedImage.TYPE_INT_ARGB
        );

        Graphics2D g = rotated.createGraphics();

        AffineTransform transform = new AffineTransform();

        transform.translate(height, 0);
        transform.rotate(Math.PI / 2);

        g.drawImage(currentImage, transform, null);
        g.dispose();

        currentImage = rotated;

        displayImage();
    }

    // Flip image horizontally
    private void flipImage() {

        if (currentImage == null) {
            showMessage();
            return;
        }

        int width = currentImage.getWidth();
        int height = currentImage.getHeight();

        BufferedImage flipped = new BufferedImage(
            width,
            height,
            BufferedImage.TYPE_INT_ARGB
        );

        Graphics2D g = flipped.createGraphics();

        g.drawImage(
            currentImage,
            width, 0,
            -width, height,
            null
        );

        g.dispose();

        currentImage = flipped;

        displayImage();
    }

    // Zoom in
    private void zoomIn() {

        if (currentImage != null && zoom < 4.0) {

            zoom += 0.2;
            displayImage();

        } else {
            showMessage();
        }
    }

    // Zoom out
    private void zoomOut() {

        if (currentImage != null && zoom > 0.4) {

            zoom -= 0.2;
            displayImage();

        } else {
            showMessage();
        }
    }

    // Next image
    private void nextImage() {

        if (imageFiles.isEmpty()) {
            showMessage();
            return;
        }

        currentIndex++;

        if (currentIndex >= imageFiles.size()) {
            currentIndex = 0;
        }

        loadImage(imageFiles.get(currentIndex));
    }

    // Previous image
    private void previousImage() {

        if (imageFiles.isEmpty()) {
            showMessage();
            return;
        }

        currentIndex--;

        if (currentIndex < 0) {
            currentIndex = imageFiles.size() - 1;
        }

        loadImage(imageFiles.get(currentIndex));
    }

    // Start slideshow
    private void startSlideshow() {

        if (!imageFiles.isEmpty()) {

            slideshowTimer.start();
            statusLabel.setText("Slideshow running");

        } else {
            showMessage();
        }
    }

    // Stop slideshow
    private void stopSlideshow() {

        slideshowTimer.stop();

        statusLabel.setText("Slideshow stopped");
    }

    // Delete image
    private void deleteImage() {

        if (imageFiles.isEmpty()) {
            showMessage();
            return;
        }

        File file = imageFiles.get(currentIndex);

        int answer = JOptionPane.showConfirmDialog(
            this,
            "Are you sure you want to delete this image?",
            "Confirm Delete",
            JOptionPane.YES_NO_OPTION
        );

        if (answer == JOptionPane.YES_OPTION) {

            if (file.delete()) {

                imageFiles.remove(currentIndex);

                JOptionPane.showMessageDialog(
                    this,
                    "Image deleted successfully."
                );

                if (imageFiles.isEmpty()) {

                    currentImage = null;
                    originalImage = null;

                    imageLabel.setIcon(null);
                    imageLabel.setText("No images available");

                    statusLabel.setText("No images available");

                } else {

                    if (currentIndex >= imageFiles.size()) {
                        currentIndex = 0;
                    }

                    loadImage(imageFiles.get(currentIndex));
                }

            } else {

                JOptionPane.showMessageDialog(
                    this,
                    "Unable to delete image."
                );
            }
        }
    }

    // Display error message
    private void showMessage() {

        JOptionPane.showMessageDialog(
            this,
            "Please open an image first.",
            "Image Viewer",
            JOptionPane.INFORMATION_MESSAGE
        );
    } //End 
